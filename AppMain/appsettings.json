{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=housestock;User=housestock_user;Password=password123;Minimum Pool Size=2;Maximum Pool Size=100;Connection Lifetime=300;Pooling=true"
  },
  "Auth": {
    "AdminPassword": "admin123"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5340"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
